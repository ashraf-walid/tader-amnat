    cache.clear();

    return NextResponse.json({
      success: true,
      message: "تم مسح الذاكرة المؤقتة بنجاح",
    });
  } catch (error) {
    if (error.name === "AuthError" || error.name === "ForbiddenError") {
      return NextResponse.json(
        { success: false, error: "Unauthorized" },
        { status: 401 },
      );
    }
    return NextResponse.json(
      { success: false, error: error.message },
      { status: 500 },
    );
  }
}
