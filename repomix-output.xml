                    </div>
                    <div className="flex justify-between text-sm py-2">
                      <span className="text-slate-400">رسم دمغة الشهيد</span>
                      <span className="font-bold text-indigo-400">{fmt(STORAGE_CONFIG.GLOBAL.MARTYR_STAMP_FEE)} ج.م (ثابت)</span>
                    </div>
