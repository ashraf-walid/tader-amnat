          {/* 40ft tab */}
          <button
            onClick={() => setActiveTab('40')}
            className={`flex-1 sm:flex-none flex items-center justify-center gap-1.5 px-4 sm:px-6 py-2.5 rounded-lg text-[13px] font-bold transition-all duration-300 ease-out ${
