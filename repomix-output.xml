<style>
:root,html[data-theme="light"]{
  --bg:#f0f6ff;--fg:#171717;--muted:#64748b;
  --primary:#2563eb;--primary-fg:#ffffff;
  --card-bg:rgba(255,255,255,0.85);--card-border:rgba(255,255,255,0.65);
  --card-shadow:0 4px 32px rgba(37,99,235,0.08),0 1px 4px rgba(0,0,0,0.06),inset 0 1px 0 rgba(255,255,255,0.9);
  color-scheme:light;
}
html[data-theme="dark"]{
  --bg:#0f172a;--fg:#f1f5f9;--muted:#94a3b8;
  --primary:#3b82f6;--primary-fg:#ffffff;
  --card-bg:rgba(30,41,59,0.85);--card-border:rgba(255,255,255,0.08);
  --card-shadow:0 4px 32px rgba(0,0,0,0.4),0 1px 4px rgba(0,0,0,0.3),inset 0 1px 0 rgba(255,255,255,0.05);
