}
*{margin:0;padding:0;box-sizing:border-box;}
body{
  background:var(--bg);color:var(--fg);
  font-family:system-ui,"Segoe UI","Tahoma","Arial",sans-serif;
  min-height:100dvh;display:flex;align-items:center;justify-content:center;
